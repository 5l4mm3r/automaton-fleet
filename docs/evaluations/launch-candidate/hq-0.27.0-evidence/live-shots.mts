// Scratch (not a test, not production): the real HQ 0.27.0 LIVE build + gateway on a THROWAWAY registry with sample data.
import crypto from "crypto";
import path from "path";
const REPO = process.argv[2], OUT = process.argv[3];
const { chromium } = await import("playwright-core");
const { findPgBin } = await import(`${REPO}/src/__tests__/fleet/fixtures/ephemeral-pg.ts`);
const { startEconomyRegistry, OWNER } = await import(`${REPO}/src/__tests__/fleet/fixtures/economy-registry.ts`);
const { totp } = await import(`${REPO}/src/fleet/identity/crypto.ts`);
const { PgDashboardGateway } = await import(`${REPO}/src/fleet/dashboard/gateway.ts`);
const { createDashboardServer } = await import(`${REPO}/src/fleet/dashboard/server.ts`);
const R = await startEconomyRegistry(findPgBin()!, { founders: 2, allocationCents: 10_000 });
const su = async (sql: string, p: unknown[] = []) => { await R.q(`SET session_replication_role = replica`).catch(() => undefined); return R.q(sql, p); };
const rail = crypto.randomUUID();
await R.q(`SELECT 1`);
const pgm = await import("pg");
const pool = new pgm.default.Pool({ connectionString: R.pgc.superUrl.replace(/\/postgres$/, `/${R.pgc.dbname}`), max: 1 });
const asSuper = async (sql: string, p: unknown[] = []) => { const c = await pool.connect(); try { await c.query("SET session_replication_role = replica"); return (await c.query(sql, p)).rows; } finally { await c.query("RESET session_replication_role"); c.release(); } };
await asSuper(`INSERT INTO fleet.fleet_payment_rails (rail_id, provider, label, rail_kind, legal_entity_id, capabilities, account_ref, mode, status, created_by)
  VALUES ($1, 'paypal', 'PayPal treasury (sample)', 'shared', gen_random_uuid(), ARRAY['receive_payments'], 'T***@example.test', 'simulated', 'active', 'sample')`, [rail]);
await asSuper(`INSERT INTO fleet.fleet_paypal_balance_observations (rail_id, currency, available_minor, total_minor, observed_at) VALUES ($1, 'GBP', 22, 22, now() - interval '2 minutes'), ($1, 'USD', 0, 0, now() - interval '1 minute')`, [rail]);
void su;
const dgw = new PgDashboardGateway({ connectionString: R.pgc.dashboardUrl });
let server = createDashboardServer(dgw, { origin: "http://localhost:0", rpId: "localhost", stateKey: crypto.randomBytes(32) });
await new Promise<void>((r) => server.listen(0, "127.0.0.1", () => r()));
const port = (server.address() as { port: number }).port; server.close();
const ORIGIN = `http://localhost:${port}`;
server = createDashboardServer(dgw, { origin: ORIGIN, rpId: "localhost", stateKey: crypto.randomBytes(32), staticDir: path.join(REPO, "codex-dashboard/out") });
await new Promise<void>((r) => server.listen(port, "127.0.0.1", () => r()));
const browser = await chromium.launch({ executablePath: "/usr/bin/google-chrome", headless: true, args: ["--no-sandbox"] });
const page = await (await browser.newContext({ viewport: { width: 1400, height: 1000 } })).newPage();
const errors: string[] = []; page.on("pageerror", (e) => errors.push(String(e).slice(0, 200)));
const token = crypto.randomBytes(32).toString("base64url");
await R.q(`SELECT fleet.fleet_admin_dashboard_enroll($1, $2)`, [crypto.createHash("sha256").update(token).digest("hex"), OWNER]);
await page.goto(`${ORIGIN}/login/#enroll=${token}`);
const PW = "a long owner password for the evidence run";
let last = 0; const code = async () => { for (;;) { const now = Math.floor(Date.now() / 30_000); const s = Math.max(last + 1, now - 1); if (s <= now + 1) { last = s; return totp(secret, s * 30_000); } await new Promise((r) => setTimeout(r, 31_000 - (Date.now() % 30_000))); } };
let secret = "";
await page.getByLabel("New password").fill(PW); await page.getByLabel("Repeat the password").fill(PW);
await page.getByRole("button", { name: "Set password" }).click();
await page.getByRole("button", { name: "Confirm authenticator" }).waitFor();
secret = (await page.locator("p.font-mono").first().textContent())!.trim();
await page.getByLabel("Code from the authenticator").fill(await code());
await page.getByRole("button", { name: "Confirm authenticator" }).click();
await page.getByLabel("Password", { exact: true }).fill(PW);
await page.getByLabel("Authenticator code").first().fill(await code());
await page.getByRole("button", { name: "Sign in", exact: true }).click();
await page.waitForURL(`${ORIGIN}/`, { timeout: 30_000 });
await page.waitForTimeout(6_000);
const shot = async (n: string) => { await page.screenshot({ path: `${OUT}/${n}.png`, fullPage: false }); console.log("shot", n); };
const nav = async (label: string) => { await page.getByRole("button", { name: new RegExp(`^\\d+\\s*${label.replace(/[&]/g, "\\$&")}$`) }).first().click(); await page.waitForTimeout(4_000); };
await shot("1-overview-unresolved");
await nav("Treasury"); await shot("2-treasury-headline-unresolved");
await page.getByText("Treasury position (what is real)").scrollIntoViewIfNeeded(); await page.waitForTimeout(500); await shot("3-treasury-position-unresolved");
// Make the sample books reconcile: PayPal = books − unbacked (what the treasury should hold).
const cb = (await R.q(`SELECT fleet.fleet_capital_backing() j`))[0].j;
await asSuper(`INSERT INTO fleet.fleet_paypal_balance_observations (rail_id, currency, available_minor, total_minor, observed_at) VALUES ($1, 'GBP', $2, $2, now())`, [rail, Number(cb.booksCashMinor) - Number(cb.unbackedMinor)]);
await page.reload(); await page.waitForTimeout(6_000);
await nav("Overview"); await shot("4-overview-reconciled");
await nav("Treasury"); await shot("5-treasury-headline-reconciled");
await page.getByText("Treasury position (what is real)").scrollIntoViewIfNeeded(); await page.waitForTimeout(500); await shot("6-treasury-position-reconciled");
await nav("Money & identity"); await page.getByText("3 · Bank details and identity facts").scrollIntoViewIfNeeded(); await page.waitForTimeout(800); await shot("7-vault-not-saved");
console.log("errors", JSON.stringify(errors));
await browser.close(); server.close(); await dgw.close(); await pool.end(); await R.close(); process.exit(0);
