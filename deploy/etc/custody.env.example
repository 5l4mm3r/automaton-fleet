# /etc/automaton-fleet/custody.env — root:automaton-fleet-custody 0640 (Phase E, schema v10).
# Generated on the host by scripts/fleet-os-setup.sh --apply with a fresh
# 64-hex password; applied to PostgreSQL by scripts/fleet-db-setup.sh --apply.
# Read only by the custody executor process. Never commit a real value.
#
# v10 is INERT: this file holds ONLY the restricted database login. No custody
# provider, signer key, wallet seed, bank/exchange credential or API secret
# may be placed here (the executor refuses to start if one is configured).
# The executor also refuses if ANY admin/service/agent/operator database URL
# or Conway key is visible to it.
FLEET_CUSTODY_DATABASE_URL=postgresql://fleet_custody_login:<64-hex>@127.0.0.1:5432/automaton_fleet
