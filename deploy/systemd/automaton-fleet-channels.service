# Automaton Fleet channel gateway — schema v80 (official-API channels: Etsy Open API v3, Pinterest API v5; IndexNow).
#
# NOT INSTALLED by default (owner-approved host step: scripts/fleet-channels-setup.sh). Runs dist/fleet/channels/main.js from
# the pinned release as its own system user (automaton-fleet-channels, in no other group). It runs agents' API jobs on the
# accounts the OWNER connected, with tokens from its own vault (StateDirectory, 0700); it never pays and holds no other
# unit's credential. Database: fleet_channels_login (chx_* only) over PostgreSQL's unix socket, from channels.env.
#
# Network: the public internet only (the code allows api.etsy.com, api.pinterest.com and api.indexnow.org). No address on
# this host is reachable — loopback is denied with every private range (the database is the unix socket).

[Unit]
Description=Automaton Fleet channel gateway (official-API channels; owner-connected accounts; no listener)
Wants=postgresql.service
After=postgresql.service automaton-fleet.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=automaton-fleet-channels
Group=automaton-fleet-channels
SupplementaryGroups=
WorkingDirectory=/opt/automaton-fleet/current
ExecStart=/opt/automaton-fleet/node/bin/node dist/fleet/channels/main.js
EnvironmentFile=/etc/automaton-fleet/channels.env
Environment=NODE_ENV=production
Environment=FLEET_CHANNELS_EXPECTED_USER=automaton-fleet-channels
Environment=FLEET_CHANNELS_VAULT_DIR=/var/lib/automaton-fleet-channels/vault
Environment=HOME=/var/lib/automaton-fleet-channels
StateDirectory=automaton-fleet-channels automaton-fleet-channels/vault
StateDirectoryMode=0700
UMask=0077
MemoryMax=512M
TasksMax=64

Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=automaton-fleet-channels

IPAddressDeny=127.0.0.0/8 ::1/128 0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.168.0.0/16 198.18.0.0/15 224.0.0.0/4 240.0.0.0/4
IPAddressDeny=fc00::/7 fe80::/10 ff00::/8
# DNS: the systemd-resolved stub only (the host's resolver is 127.0.0.53; without this no name resolves). No other
# local address is reachable — the same exception as automaton-fleet-chatgpt-tunnel.service.
IPAddressAllow=127.0.0.53/32 127.0.0.54/32
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
InaccessiblePaths=-/etc/automaton-fleet/admin.env -/etc/automaton-fleet/service.env -/etc/automaton-fleet/operator.env -/etc/automaton-fleet/custody.env -/etc/automaton-fleet/identity.env -/etc/automaton-fleet/browser.env -/etc/automaton-fleet/gumroad.env -/etc/automaton-fleet/tls -/etc/automaton-fleet/cognition.key
InaccessiblePaths=-/home -/var/lib/automaton-fleet -/var/lib/automaton-fleet-custody -/var/lib/automaton-fleet-identity -/var/lib/automaton-fleet-witness -/var/lib/automaton-fleet-gumroad -/var/lib/private/automaton-founders -/var/log/automaton-fleet -/run/credentials

[Install]
WantedBy=multi-user.target
