# Automaton Fleet build environment — schema v89 (builds and tests of customers' code; holds NO credentials).
#
# NOT INSTALLED by default (owner-approved host step: scripts/fleet-code-setup.sh). Runs dist/fleet/build/main.js as its own
# system user (automaton-fleet-build, in no other group). Each job unpacks a repository snapshot into a fresh 0700 directory
# under its state directory, applies the agent's patch strictly, and runs the agent's commands in the Landlock sandbox; the
# directory is removed afterwards. Database: fleet_build_login (bbx_* only) over PostgreSQL's unix socket.
#
# Network: LOOPBACK ONLY (IPAddressDeny=any, IPAddressAllow=localhost); inside the sandbox one TCP port is reachable: the
# egress proxy (automaton-fleet-build-proxy, HTTPS to package registries only). No credentials of any kind: the program
# refuses to start with any credential or a systemd credentials directory in its environment.

[Unit]
Description=Automaton Fleet build environment (isolated builds and tests; no listener, no credentials)
Wants=postgresql.service automaton-fleet-build-proxy.service
After=postgresql.service automaton-fleet.service automaton-fleet-build-proxy.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=automaton-fleet-build
Group=automaton-fleet-build
SupplementaryGroups=
WorkingDirectory=/opt/automaton-fleet/current
ExecStart=/opt/automaton-fleet/node/bin/node dist/fleet/build/main.js
EnvironmentFile=/etc/automaton-fleet/build.env
Environment=NODE_ENV=production
Environment=FLEET_BUILD_EXPECTED_USER=automaton-fleet-build
Environment=FLEET_BUILD_PROXY_PORT=3129
Environment=HOME=/var/lib/automaton-fleet-build
StateDirectory=automaton-fleet-build
StateDirectoryMode=0700
UMask=0077
MemoryMax=4G
TasksMax=256
CPUQuota=200%

Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=automaton-fleet-build

IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
# The whole configuration directory is hidden: systemd itself reads this unit's EnvironmentFile
# before the namespace applies, so nothing under it — another service's env file or key, or a file added later — is visible.
InaccessiblePaths=-/etc/automaton-fleet
InaccessiblePaths=-/home -/var/lib/automaton-fleet -/var/lib/automaton-fleet-custody -/var/lib/automaton-fleet-identity -/var/lib/automaton-fleet-witness -/var/lib/automaton-fleet-gumroad -/var/lib/automaton-fleet-channels -/var/lib/private/automaton-founders -/var/log/automaton-fleet

[Install]
WantedBy=multi-user.target
