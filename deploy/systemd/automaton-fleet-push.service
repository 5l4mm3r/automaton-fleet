# Automaton Fleet phone-push sender — schema v83 (Pushover; owner notifications to the owner's phones).
#
# NOT INSTALLED by default (owner-approved host step: scripts/fleet-push-setup.sh). Runs dist/fleet/push/main.js from the
# pinned release as its own system user (automaton-fleet-push, in no other group). It sends only a severity word, a
# notification code, a short id and a link to the authenticated dashboard; never a notification's text, a customer or a
# document. Database: fleet_push_login (px_* only) over PostgreSQL's unix socket, from push.env.
#
# Credentials (an absent file falls back to a placeholder SetCredential= ("unset", rejected as a key), so the unit starts "not configured"): the Pushover application token and the owner's user key as systemd credentials (root-owned 0600 files under
# /etc/automaton-fleet/push/, handed to this unit only, never in its environment). Without them the sender runs "not
# configured": the dashboard says so and nothing is sent.
#
# Network: the public internet only (the code allows https://api.pushover.net only). No address on this host is reachable.

[Unit]
Description=Automaton Fleet phone-push sender (Pushover; no listener)
Wants=postgresql.service
After=postgresql.service automaton-fleet.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=automaton-fleet-push
Group=automaton-fleet-push
SupplementaryGroups=
WorkingDirectory=/opt/automaton-fleet/current
ExecStart=/opt/automaton-fleet/node/bin/node dist/fleet/push/main.js
EnvironmentFile=/etc/automaton-fleet/push.env
Environment=NODE_ENV=production
Environment=FLEET_PUSH_EXPECTED_USER=automaton-fleet-push
Environment=FLEET_PUSH_DASHBOARD_ORIGIN=https://admin.agentfleet.vip
Environment=HOME=/var/lib/automaton-fleet-push
LoadCredential=pushover-token:/etc/automaton-fleet/push/pushover-token
SetCredential=pushover-token:unset
LoadCredential=pushover-user:/etc/automaton-fleet/push/pushover-user
SetCredential=pushover-user:unset
StateDirectory=automaton-fleet-push
StateDirectoryMode=0700
UMask=0077
MemoryMax=256M
TasksMax=32

Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=automaton-fleet-push

IPAddressDeny=127.0.0.0/8 ::1/128 0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.168.0.0/16 198.18.0.0/15 224.0.0.0/4 240.0.0.0/4
IPAddressDeny=fc00::/7 fe80::/10 ff00::/8
# DNS: the systemd-resolved stub only (the host's resolver is 127.0.0.53; without this no name resolves). No other
# local address is reachable — the same exception as automaton-fleet-chatgpt-tunnel.service.
IPAddressAllow=127.0.0.53/32 127.0.0.54/32
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
InaccessiblePaths=-/etc/automaton-fleet/admin.env -/etc/automaton-fleet/service.env -/etc/automaton-fleet/operator.env -/etc/automaton-fleet/custody.env -/etc/automaton-fleet/identity.env -/etc/automaton-fleet/browser.env -/etc/automaton-fleet/gumroad.env -/etc/automaton-fleet/channels.env -/etc/automaton-fleet/tls -/etc/automaton-fleet/cognition.key -/etc/automaton-fleet/push -/etc/automaton-fleet/bankfeed -/etc/automaton-fleet/code.env -/etc/automaton-fleet/build.env -/etc/automaton-fleet/code -/etc/automaton-fleet/bankfeed.env -/etc/automaton-fleet/media
InaccessiblePaths=-/home -/var/lib/automaton-fleet -/var/lib/automaton-fleet-custody -/var/lib/automaton-fleet-identity -/var/lib/automaton-fleet-witness -/var/lib/automaton-fleet-gumroad -/var/lib/automaton-fleet-channels -/var/lib/private/automaton-founders -/var/log/automaton-fleet

[Install]
WantedBy=multi-user.target
