# Automaton Fleet media provider gateway — schema v85 (web search and image generation for the agents).
#
# NOT INSTALLED by default (owner-approved host step: scripts/fleet-media-setup.sh). Runs dist/fleet/media/main.js from the
# pinned release as its own system user (automaton-fleet-media, in no other group). It runs the agents' search and image
# jobs with the provider the owner chose (media.env: FLEET_MEDIA_SEARCH_PROVIDER brave|none, FLEET_MEDIA_IMAGE_PROVIDER
# openai|none, per-job cost estimates) and records each result and its cost. Database: fleet_media_login (mx_* only) over
# PostgreSQL's unix socket.
#
# Credentials: each provider's API key as a systemd credential (root-owned 0600 files under /etc/automaton-fleet/media/,
# handed to this unit only, never in its environment). A provider without its key is reported "not connected" and agents
# are told so.
#
# Network: the public internet only (the code allows the chosen providers' API hosts only). No address on this host is
# reachable.

[Unit]
Description=Automaton Fleet media provider gateway (search, images; no listener)
Wants=postgresql.service
After=postgresql.service automaton-fleet.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=automaton-fleet-media
Group=automaton-fleet-media
SupplementaryGroups=
WorkingDirectory=/opt/automaton-fleet/current
ExecStart=/opt/automaton-fleet/node/bin/node dist/fleet/media/main.js
EnvironmentFile=/etc/automaton-fleet/media.env
Environment=NODE_ENV=production
Environment=FLEET_MEDIA_EXPECTED_USER=automaton-fleet-media
Environment=HOME=/var/lib/automaton-fleet-media
LoadCredential=search-key:/etc/automaton-fleet/media/search-key
LoadCredential=image-key:/etc/automaton-fleet/media/image-key
StateDirectory=automaton-fleet-media
StateDirectoryMode=0700
UMask=0077
MemoryMax=256M
TasksMax=32

Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=automaton-fleet-media

IPAddressDeny=127.0.0.0/8 ::1/128 0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.168.0.0/16 198.18.0.0/15 224.0.0.0/4 240.0.0.0/4
IPAddressDeny=fc00::/7 fe80::/10 ff00::/8
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
InaccessiblePaths=-/etc/automaton-fleet/admin.env -/etc/automaton-fleet/service.env -/etc/automaton-fleet/operator.env -/etc/automaton-fleet/custody.env -/etc/automaton-fleet/identity.env -/etc/automaton-fleet/browser.env -/etc/automaton-fleet/gumroad.env -/etc/automaton-fleet/channels.env -/etc/automaton-fleet/tls -/etc/automaton-fleet/cognition.key -/etc/automaton-fleet/push -/etc/automaton-fleet/media
InaccessiblePaths=-/home -/var/lib/automaton-fleet -/var/lib/automaton-fleet-custody -/var/lib/automaton-fleet-identity -/var/lib/automaton-fleet-witness -/var/lib/automaton-fleet-gumroad -/var/lib/automaton-fleet-channels -/var/lib/private/automaton-founders -/var/log/automaton-fleet

[Install]
WantedBy=multi-user.target
