# Automaton Fleet code gateway — schema v89 (customers' repositories through the Fleet GitHub App).
#
# NOT INSTALLED by default (owner-approved host step: scripts/fleet-code-setup.sh). Runs dist/fleet/code/main.js from the
# pinned release as its own system user (automaton-fleet-code, in no other group). It activates a customer's access when
# their consent and the app's installation name the same repository, reads snapshots, and opens pull requests from new
# fleet/ branches only. Database: fleet_code_login (cgx_* only) over PostgreSQL's unix socket.
#
# Credentials: the GitHub App's private key as a systemd credential (/etc/automaton-fleet/code/github-app-key, root 0600),
# handed to this unit only; absent, a placeholder SetCredential ("unset", rejected as a key) starts the unit "not configured" (customers' access stays pending).
#
# Network: the public internet only (the code allows api.github.com and its codeload redirect only).

[Unit]
Description=Automaton Fleet code gateway (customer repositories; no listener)
Wants=postgresql.service
After=postgresql.service automaton-fleet.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=automaton-fleet-code
Group=automaton-fleet-code
SupplementaryGroups=
WorkingDirectory=/opt/automaton-fleet/current
ExecStart=/opt/automaton-fleet/node/bin/node dist/fleet/code/main.js
EnvironmentFile=/etc/automaton-fleet/code.env
Environment=NODE_ENV=production
Environment=FLEET_CODE_EXPECTED_USER=automaton-fleet-code
Environment=HOME=/var/lib/automaton-fleet-code
LoadCredential=github-app-key:/etc/automaton-fleet/code/github-app-key
SetCredential=github-app-key:unset
StateDirectory=automaton-fleet-code
StateDirectoryMode=0700
UMask=0077
MemoryMax=512M
TasksMax=32

Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=automaton-fleet-code

IPAddressDeny=127.0.0.0/8 ::1/128 0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.168.0.0/16 198.18.0.0/15 224.0.0.0/4 240.0.0.0/4
IPAddressDeny=fc00::/7 fe80::/10 ff00::/8
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
InaccessiblePaths=-/etc/automaton-fleet/admin.env -/etc/automaton-fleet/service.env -/etc/automaton-fleet/operator.env -/etc/automaton-fleet/custody.env -/etc/automaton-fleet/identity.env -/etc/automaton-fleet/browser.env -/etc/automaton-fleet/gumroad.env -/etc/automaton-fleet/channels.env -/etc/automaton-fleet/push.env -/etc/automaton-fleet/media.env -/etc/automaton-fleet/bankfeed.env -/etc/automaton-fleet/tls -/etc/automaton-fleet/cognition.key -/etc/automaton-fleet/push -/etc/automaton-fleet/media -/etc/automaton-fleet/bankfeed -/etc/automaton-fleet/code -/etc/automaton-fleet/code.env -/etc/automaton-fleet/build.env
InaccessiblePaths=-/home -/var/lib/automaton-fleet -/var/lib/automaton-fleet-custody -/var/lib/automaton-fleet-identity -/var/lib/automaton-fleet-witness -/var/lib/automaton-fleet-gumroad -/var/lib/automaton-fleet-channels -/var/lib/private/automaton-founders -/var/log/automaton-fleet

[Install]
WantedBy=multi-user.target
