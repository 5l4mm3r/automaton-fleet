# Automaton Fleet bank feed — schema v86 (reads bank accounts into the money locations; moves nothing).
#
# NOT INSTALLED by default (owner-approved host step: scripts/fleet-bankfeed-setup.sh). Runs
# dist/fleet/settlement/location-feed-main.js from the pinned release as its own system user (automaton-fleet-bankfeed, in no
# other group). It reads each configured account's balance and transactions with a READ-ONLY token and records them through
# rx_* (fleet_bankfeed_login, over PostgreSQL's unix socket, from bankfeed.env). A token with any scope that is not read-only
# is refused at every pass.
#
# Credentials: one read-only token per bank account as a systemd credential (root-owned 0600 files bank/<locationId> under
# /etc/automaton-fleet/bankfeed/, handed to this unit only as bank_<locationId>, never in its environment). A location
# without one is skipped: it keeps waiting for statement imports.
#
# Network: the public internet only (the code allows https://api.starlingbank.com only). No address on this host is reachable.

[Unit]
Description=Automaton Fleet bank feed (read-only bank evidence; no listener)
Wants=postgresql.service
After=postgresql.service automaton-fleet.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=automaton-fleet-bankfeed
Group=automaton-fleet-bankfeed
SupplementaryGroups=
WorkingDirectory=/opt/automaton-fleet/current
ExecStart=/opt/automaton-fleet/node/bin/node dist/fleet/settlement/location-feed-main.js
EnvironmentFile=/etc/automaton-fleet/bankfeed.env
Environment=NODE_ENV=production
Environment=FLEET_BANKFEED_EXPECTED_USER=automaton-fleet-bankfeed
Environment=HOME=/var/lib/automaton-fleet-bankfeed
LoadCredential=bank:/etc/automaton-fleet/bankfeed
StateDirectory=automaton-fleet-bankfeed
StateDirectoryMode=0700
UMask=0077
MemoryMax=256M
TasksMax=32

Restart=on-failure
RestartSec=30s
TimeoutStopSec=20s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=automaton-fleet-bankfeed

IPAddressDeny=127.0.0.0/8 ::1/128 0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.168.0.0/16 198.18.0.0/15 224.0.0.0/4 240.0.0.0/4
IPAddressDeny=fc00::/7 fe80::/10 ff00::/8
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
InaccessiblePaths=-/etc/automaton-fleet/admin.env -/etc/automaton-fleet/service.env -/etc/automaton-fleet/operator.env -/etc/automaton-fleet/custody.env -/etc/automaton-fleet/identity.env -/etc/automaton-fleet/browser.env -/etc/automaton-fleet/gumroad.env -/etc/automaton-fleet/channels.env -/etc/automaton-fleet/push.env -/etc/automaton-fleet/media.env -/etc/automaton-fleet/tls -/etc/automaton-fleet/cognition.key -/etc/automaton-fleet/push -/etc/automaton-fleet/media -/etc/automaton-fleet/bankfeed
InaccessiblePaths=-/home -/var/lib/automaton-fleet -/var/lib/automaton-fleet-custody -/var/lib/automaton-fleet-identity -/var/lib/automaton-fleet-witness -/var/lib/automaton-fleet-gumroad -/var/lib/automaton-fleet-channels -/var/lib/private/automaton-founders -/var/log/automaton-fleet

[Install]
WantedBy=multi-user.target
