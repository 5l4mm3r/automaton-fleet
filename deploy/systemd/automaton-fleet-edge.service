# Automaton Fleet TLS edge (R36): nginx on :443 — SNI routing with PROXY protocol v1 to FleetController
# (127.0.0.1:8443, TLS passthrough) and TLS termination for admin.agentfleet.vip (→ dashboard 127.0.0.1:8790).
# Configuration: /etc/nginx/automaton-fleet-edge.conf (deploy/nginx/automaton-fleet-edge.conf). Installed and started
# only by scripts/fleet-edge.sh cutover; the stock nginx.service stays disabled.
#
# The master runs as root only to bind :443 and read the admin certificate; workers run as www-data. It cannot read
# Fleet secrets, the API certificate's private key (that TLS terminates in FleetController) or any service state.

[Unit]
Description=Automaton Fleet TLS edge (nginx: :443 SNI routing, PROXY protocol, admin.agentfleet.vip TLS)
Wants=network-online.target
After=network-online.target automaton-fleet.service automaton-fleet-dashboard.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=forking
PIDFile=/run/automaton-fleet-edge.pid
ExecStartPre=/usr/sbin/nginx -t -q -c /etc/nginx/automaton-fleet-edge.conf
ExecStart=/usr/sbin/nginx -c /etc/nginx/automaton-fleet-edge.conf
ExecReload=/usr/sbin/nginx -t -q -c /etc/nginx/automaton-fleet-edge.conf
ExecReload=/usr/sbin/nginx -s reload -c /etc/nginx/automaton-fleet-edge.conf
ExecStop=-/sbin/start-stop-daemon --quiet --stop --retry QUIT/5 --pidfile /run/automaton-fleet-edge.pid
TimeoutStopSec=10s
KillMode=mixed
Restart=on-failure
RestartSec=5s
SyslogIdentifier=automaton-fleet-edge

CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_KILL
NoNewPrivileges=true
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
InaccessiblePaths=-/etc/automaton-fleet -/etc/letsencrypt/live/api.agentfleet.vip -/etc/letsencrypt/archive/api.agentfleet.vip -/etc/letsencrypt/keys -/etc/letsencrypt/accounts
InaccessiblePaths=-/var/lib/automaton-fleet -/var/lib/automaton-fleet-dashboard -/var/lib/automaton-fleet-identity -/var/lib/automaton-fleet-custody -/var/lib/automaton-fleet-witness -/var/lib/automaton-fleet-backups -/var/lib/private -/var/log/automaton-fleet -/opt/automaton-fleet -/run/credentials

[Install]
WantedBy=multi-user.target
